-
-/** "NE @ SEA" + "AWAY" → "NE". Null when no pick was made. */
-function pickedTeam(row: PickHistoryRow): string | null {
-  if (!row.picked) return null;
-  const [away, home] = row.game.split(" @ ");
-  const team = row.picked === "HOME" ? home : away;
-  return team ?? null;
-}
-
-/** The line as the picker took it: `+3.5`, `−3.5`, `PK` for a pick'em. */
-function spreadLabel(spread: number | null): string {
-  if (spread === null) return "";
-  if (spread === 0) return "PK";
-  const size = Math.abs(spread);
-  return spread > 0 ? `+${size}` : `${MINUS}${size}`;
