-/**
- * Every pick a player has made, grouped by week, newest week first.
- *
- * The pick cell is the point of the table: it names the side the player
- * actually took and the line they took it at — `NE +3.5`, `SEA −3.5` — which
- * is the only place on the site where a spread is shown from the picker's
- * point of view. `spread` arrives already flipped to the picked team's side
- * (positive = getting points = an underdog pick), so nothing is recomputed
- * here.
- *
- * Four results exist and all four are visible: CORRECT, INCORRECT, PENDING
- * (played or not, the pool has not scored it) and MISSING (a completed
- * week's game this player never picked). PENDING is deliberately quiet —
- * most of the season's rows are pending, and colouring them would drown the
- * two that matter.
- */
-
-import type { PickHistoryRow } from "../api";
-
-/** U+2212, the real minus sign: −3.5 lines up under a digit, -3.5 does not. */
-const MINUS = "−";
